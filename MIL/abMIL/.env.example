# -----------------------------------------------------------------------------
# Environment variables for MIL/abMIL
#
# Setup:
#   cp MIL/abMIL/.env.example MIL/abMIL/.env
#   # then edit MIL/abMIL/.env and fill in the values below
#
# The train/test scripts load this file from MIL/abMIL/.env (next to train.py),
# regardless of the directory you run them from. .env is gitignored. Never
# commit it.
# -----------------------------------------------------------------------------

# Weights & Biases API key, used for experiment logging.
# Get yours at https://wandb.ai/authorize
#
# Required whenever a script runs with --use_wandb. run_experiment.sh always
# passes --use_wandb, so you need this key to use the launcher. To run without
# WandB, call train.py / train_slide.py / test.py / test_slide.py / ood_test.py
# directly and leave out --use_wandb (see README.md, "Running without WandB").
WANDB_API_KEY=your_wandb_api_key_here
